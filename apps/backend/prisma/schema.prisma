generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Disponibilidad {
  EN_LINEA
  AUSENTE
  NO_MOLESTAR
  INVISIBLE

  @@map("disponibilidad")
}

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA

  @@map("estado_solicitud")
}

enum TipoComunidad {
  PUBLICA
  PRIVADA

  @@map("tipo_comunidad")
}

enum RolComunidad {
  PROPIETARIO
  ADMIN
  MODERADOR
  INTEGRANTE

  @@map("rol_comunidad")
}

enum TipoCanal {
  TEXTO
  VOZ

  @@map("tipo_canal")
}

enum PermisoCanal {
  VER
  ESCRIBIR
  HABLAR
  TRANSMITIR
  CAMARA
  PANTALLA
  SILENCIAR
  ELIMINAR_MENSAJES
  BANEAR
  EXPULSAR
  GESTIONAR_CANALES
  GESTIONAR_INVITACIONES
  GESTIONAR_ROLES
  EDITAR_COMUNIDAD
  GESTIONAR_MODERACION

  @@map("permiso_canal")
}

model Usuario {
  portadaUrl String? @map("portada_url")
  bloqueosRealizados BloqueoUsuario[] @relation("BloqueoActor")
  bloqueosRecibidos BloqueoUsuario[] @relation("BloqueoObjetivo")
  estadosChat EstadoChat[]
  id                  Int            @id @default(autoincrement()) @map("id_usuario")
  nombreUsuario       String         @unique @map("nombre_usuario") @db.VarChar(32)
  correo              String         @unique @db.VarChar(254)
  hashContrasena      String         @map("hash_contrasena")
  nombreVisible       String         @map("nombre_visible") @db.VarChar(64)
  fotoUrl             String?        @map("foto_url")
  preferencias Json @default("{}")
  notificaciones Notificacion[]
  colorAvatar         String         @default("#756222") @map("color_avatar") @db.VarChar(7)
  informacionPersonal String?        @map("informacion_personal") @db.VarChar(500)
  disponibilidad      Disponibilidad @default(EN_LINEA)
  fechaCreacion       DateTime       @default(now()) @map("fecha_creacion")

  sesiones             Sesion[]
  recuperaciones       RecuperacionCuenta[]
  solicitudesEnviadas  SolicitudAmistad[]    @relation("SolicitudEmisor")
  solicitudesRecibidas SolicitudAmistad[]    @relation("SolicitudReceptor")
  amistadesComoA       Amistad[]             @relation("AmistadUsuarioA")
  amistadesComoB       Amistad[]             @relation("AmistadUsuarioB")
  conversacionesComoA  ConversacionPrivada[] @relation("ConversacionUsuarioA")
  conversacionesComoB  ConversacionPrivada[] @relation("ConversacionUsuarioB")
  enviosConfirmados EnvioConfirmado[]
  creacionesComunidad CreacionComunidad[]
  propuestasCanales PropuestaCanales[]
  llamadasEmitidas LlamadaPrivada[] @relation("LlamadaEmisor")
  llamadasRecibidas LlamadaPrivada[] @relation("LlamadaReceptor")
  reacciones ReaccionMensaje[]
  tituloPerfil String? @db.VarChar(80) @map("titulo_perfil")
  pronombres String? @db.VarChar(30)
  colorPerfil String? @db.VarChar(7) @map("color_perfil")
  votosEncuesta VotoEncuesta[]
  mensajesEscritos     Mensaje[]             @relation("MensajeAutor")
  mensajesEliminados   Mensaje[]             @relation("MensajeEliminadoPor")
  membresias           Membresia[]
  baneosRecibidos      ComunidadBaneo[] @relation("UsuarioBaneado")
  baneosAplicados      ComunidadBaneo[] @relation("AutorBaneo")
  silenciosRecibidos   SilencioComunidad[] @relation("UsuarioSilenciado")
  silenciosAplicados   SilencioComunidad[] @relation("AutorSilencio")
  propuestasSolicitadas PropuestaModeracion[] @relation("PropuestaSolicitante")
  propuestasRecibidas   PropuestaModeracion[] @relation("PropuestaDestinatario")
  propuestasConfirmadas PropuestaModeracion[] @relation("PropuestaConfirmador")
  invitacionesCreadas  Invitacion[]          @relation("InvitacionCreador")
  participacionLlamada ParticipanteLlamada?
  bloqueosMensaje BloqueoMensaje[]

  @@map("usuario")
}

model Sesion {
  id              Int       @id @default(autoincrement()) @map("id_sesion")
  idUsuario       Int       @map("id_usuario")
  hashToken       String    @unique @map("hash_token")
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion")
  fechaExpiracion DateTime  @map("fecha_expiracion")
  fechaRevocacion DateTime? @map("fecha_revocacion")

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  participacionesLlamada ParticipanteLlamada[]

  @@index([idUsuario])
  @@map("sesion")
}

model RecuperacionCuenta {
  id               Int       @id @default(autoincrement()) @map("id_recuperacion")
  idUsuario        Int       @map("id_usuario")
  hashToken        String    @unique @map("hash_token")
  fechaCreacion    DateTime  @default(now()) @map("fecha_creacion")
  fechaExpiracion  DateTime  @map("fecha_expiracion")
  fechaUtilizacion DateTime? @map("fecha_utilizacion")

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@map("recuperacion_cuenta")
}

model SolicitudAmistad {
  id             Int             @id @default(autoincrement()) @map("id_solicitud")
  idEmisor       Int             @map("id_emisor")
  idReceptor     Int             @map("id_receptor")
  estado         EstadoSolicitud @default(PENDIENTE)
  fechaCreacion  DateTime        @default(now()) @map("fecha_creacion")
  fechaRespuesta DateTime?       @map("fecha_respuesta")

  emisor   Usuario @relation("SolicitudEmisor", fields: [idEmisor], references: [id], onDelete: Cascade)
  receptor Usuario @relation("SolicitudReceptor", fields: [idReceptor], references: [id], onDelete: Cascade)

  @@index([idReceptor, estado])
  @@index([idEmisor, estado])
  @@map("solicitud_amistad")
}

model Amistad {
  idUsuarioA    Int      @map("id_usuario_a")
  idUsuarioB    Int      @map("id_usuario_b")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  usuarioA Usuario @relation("AmistadUsuarioA", fields: [idUsuarioA], references: [id], onDelete: Cascade)
  usuarioB Usuario @relation("AmistadUsuarioB", fields: [idUsuarioB], references: [id], onDelete: Cascade)

  @@id([idUsuarioA, idUsuarioB])
  @@index([idUsuarioB])
  @@map("amistad")
}

model ConversacionPrivada {
  id            Int      @id @default(autoincrement()) @map("id_conversacion")
  idUsuarioA    Int      @map("id_usuario_a")
  idUsuarioB    Int      @map("id_usuario_b")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  usuarioA Usuario   @relation("ConversacionUsuarioA", fields: [idUsuarioA], references: [id], onDelete: Cascade)
  usuarioB Usuario   @relation("ConversacionUsuarioB", fields: [idUsuarioB], references: [id], onDelete: Cascade)
  llamadas LlamadaPrivada[]
  mensajes Mensaje[]

  @@unique([idUsuarioA, idUsuarioB])
  @@index([idUsuarioB])
  @@map("conversacion_privada")
}

model EnvioConfirmado {
  idAutor Int @map("id_autor")
  clave String @db.Uuid
  huella String @db.VarChar(64)
  mensajes Int[]
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")
  autor Usuario @relation(fields:[idAutor], references:[id], onDelete:Cascade)
  @@id([idAutor,clave])
  @@map("envio_confirmado")
}

// Recibo durable: una confirmación repetida no recrea una comunidad eliminada.
model CreacionComunidad {
  idAutor Int @map("id_autor")
  clave String @db.Uuid
  huella String @db.VarChar(64)
  idComunidad Int @map("id_comunidad")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")
  autor Usuario @relation(fields: [idAutor], references: [id], onDelete: Cascade)
  @@id([idAutor, clave])
  @@map("creacion_comunidad")
}

model Mensaje {
  casosRevision CasoRevision[]
  id                   Int       @id @default(autoincrement()) @map("id_mensaje")
  idAutor              Int       @map("id_autor")
  idConversacion       Int?      @map("id_conversacion")
  idCanal              Int?      @map("id_canal")
  contenido            String    @db.VarChar(2000)
  idGrupoAdjuntos     String?   @db.Uuid @map("id_grupo_adjuntos")
  cantidadGrupoAdjuntos Int?    @map("cantidad_grupo_adjuntos")
  registroLlamada      Boolean   @default(false) @map("registro_llamada")
  fechaCreacion        DateTime  @default(now()) @map("fecha_creacion")
  fechaEdicion         DateTime? @map("fecha_edicion")
  fechaEliminacion     DateTime? @map("fecha_eliminacion")
  idUsuarioEliminacion Int?      @map("id_usuario_eliminacion")

  idHilo Int? @map("id_hilo")
  hilo Mensaje? @relation("Hilos",fields:[idHilo],references:[id],onDelete:Cascade)
  hijosHilo Mensaje[] @relation("Hilos")
  encuesta Encuesta?
  fechaEntrega DateTime? @map("fecha_entrega")
  fechaLectura DateTime? @map("fecha_lectura")
  idRespuesta Int? @map("id_respuesta")
  fechaFijado DateTime? @map("fecha_fijado")
  respuesta Mensaje? @relation("Respuestas", fields:[idRespuesta], references:[id], onDelete:SetNull)
  respuestas Mensaje[] @relation("Respuestas")
  reacciones ReaccionMensaje[]

  adjunto Adjunto?
  autor        Usuario              @relation("MensajeAutor", fields: [idAutor], references: [id], onDelete: Cascade)
  conversacion ConversacionPrivada? @relation(fields: [idConversacion], references: [id], onDelete: Cascade)
  canal        Canal?               @relation(fields: [idCanal], references: [id], onDelete: Cascade)
  eliminadoPor Usuario?             @relation("MensajeEliminadoPor", fields: [idUsuarioEliminacion], references: [id], onDelete: SetNull)

  // Mismo orden que el historial (más nuevos primero, desempate por id): la página sale del índice sin ordenar.
  @@index([idConversacion, fechaCreacion(sort: Desc), id(sort: Desc)], map: "mensaje_conversacion_historial")
  @@index([idCanal, fechaCreacion(sort: Desc), id(sort: Desc)], map: "mensaje_canal_historial")
  @@index([idHilo,id],map:"mensaje_hilo_idx")
  @@index([idRespuesta], map:"mensaje_respuesta_idx")
  @@map("mensaje")
}

model Comunidad {
  id            Int           @id @default(autoincrement()) @map("id_comunidad")
  nombre        String        @db.VarChar(64)
  imagenUrl     String?       @map("imagen_url")
  tipo          TipoComunidad @default(PRIVADA)
  fechaCreacion DateTime      @default(now()) @map("fecha_creacion")
  moderacionActiva Boolean    @default(false) @map("moderacion_activa")

  membresias   Membresia[]
  invitaciones Invitacion[]
  canales      Canal[]
  rolesPersonalizados RolPersonalizado[]
  baneos ComunidadBaneo[]
  silencios SilencioComunidad[]
  propuestasModeracion PropuestaModeracion[]
  reglasModeracion ReglaModeracion[]
  bloqueosMensaje BloqueoMensaje[]
  propuestasCanales PropuestaCanales[]
  casosRevision CasoRevision[]
  revisionActiva Boolean @default(false) @map("revision_activa")

  @@index([tipo])
  @@map("comunidad")
}

model ReglaModeracion {
  id            Int      @id @default(autoincrement()) @map("id_regla")
  idComunidad   Int      @map("id_comunidad")
  descripcion   String   @db.VarChar(100)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  comunidad Comunidad @relation(fields: [idComunidad], references: [id], onDelete: Cascade)

  @@index([idComunidad])
  @@map("regla_moderacion")
}

model ComunidadBaneo {
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  idComunidad   Int          @map("id_comunidad")
  idUsuario     Int          @map("id_usuario")
  idAutor       Int?         @map("id_autor")
  rolAnterior   RolComunidad @map("rol_anterior")
  motivo        String?      @db.VarChar(300)
  fechaCreacion DateTime     @default(now()) @map("fecha_creacion")

  comunidad Comunidad @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation("UsuarioBaneado", fields: [idUsuario], references: [id], onDelete: Cascade)
  autor     Usuario?  @relation("AutorBaneo", fields: [idAutor], references: [id], onDelete: SetNull)

  @@id([idComunidad, idUsuario])
  @@index([idUsuario])
  @@index([idAutor])
  @@map("comunidad_baneo")
}

enum AlcanceSilencio {
  TEXTO
  VOZ
  AMBOS

  @@map("alcance_silencio")
}

enum MedidaModeracion {
  SILENCIAR
  EXPULSAR
  BANEAR
  QUITAR_SILENCIO
  DESBANEAR

  @@map("medida_moderacion")
}

enum EstadoPropuesta {
  PENDIENTE
  CONFIRMADA
  CANCELADA

  @@map("estado_propuesta")
}

// Silencio de comunidad (F-14): limita escribir y/o hablar en todos sus canales mientras esté vigente.
model SilencioComunidad {
  idComunidad      Int             @map("id_comunidad")
  idUsuario        Int             @map("id_usuario")
  idAutor          Int?            @map("id_autor")
  alcance          AlcanceSilencio
  motivo           String?         @db.VarChar(300)
  fechaVencimiento DateTime?       @map("fecha_vencimiento")
  fechaCreacion    DateTime        @default(now()) @map("fecha_creacion")

  comunidad Comunidad @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation("UsuarioSilenciado", fields: [idUsuario], references: [id], onDelete: Cascade)
  autor     Usuario?  @relation("AutorSilencio", fields: [idAutor], references: [id], onDelete: SetNull)

  @@id([idComunidad, idUsuario])
  @@index([idUsuario])
  @@map("silencio_comunidad")
}

// Medida preparada con IA: se confirma o cancela tal como se revisó.
model PropuestaModeracion {
  id               Int              @id @default(autoincrement()) @map("id_propuesta")
  idComunidad      Int              @map("id_comunidad")
  idSolicitante    Int              @map("id_solicitante")
  idDestinatario   Int              @map("id_destinatario")
  idConfirmador    Int?             @map("id_confirmador")
  medida           MedidaModeracion
  alcance          AlcanceSilencio?
  duracion         String           @db.VarChar(16)
  motivo           String?          @db.VarChar(300)
  estado           EstadoPropuesta  @default(PENDIENTE)
  fechaCreacion    DateTime         @default(now()) @map("fecha_creacion")
  fechaVencimiento DateTime         @map("fecha_vencimiento")
  fechaResolucion  DateTime?        @map("fecha_resolucion")

  comunidad    Comunidad @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  solicitante  Usuario   @relation("PropuestaSolicitante", fields: [idSolicitante], references: [id], onDelete: Cascade)
  destinatario Usuario   @relation("PropuestaDestinatario", fields: [idDestinatario], references: [id], onDelete: Cascade)
  confirmador  Usuario?  @relation("PropuestaConfirmador", fields: [idConfirmador], references: [id], onDelete: SetNull)

  @@index([idComunidad, id])
  @@map("propuesta_moderacion")
}

model Membresia {
  idComunidad  Int          @map("id_comunidad")
  idUsuario    Int          @map("id_usuario")
  rol          RolComunidad @default(INTEGRANTE)
  fechaIngreso DateTime     @default(now()) @map("fecha_ingreso")

  comunidad      Comunidad      @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  usuario        Usuario        @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  habilitaciones CanalUsuario[]
  solicitudesCanal SolicitudAccesoCanal[]
  expulsionesCanal CanalExpulsion[]
  silencios CanalSilencio[]
  rolesPersonalizados MembresiaRol[]

  @@id([idComunidad, idUsuario])
  @@index([idUsuario, fechaIngreso])
  @@map("membresia")
}

model Invitacion {
  id              Int       @id @default(autoincrement()) @map("id_invitacion")
  idComunidad     Int       @map("id_comunidad")
  idCreador       Int       @map("id_creador")
  codigo          String    @unique @db.VarChar(16)
  usosMaximos     Int?      @map("usos_maximos")
  usos            Int       @default(0)
  fechaExpiracion DateTime? @map("fecha_expiracion")
  fechaRevocacion DateTime? @map("fecha_revocacion")
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion")

  comunidad Comunidad @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  creador   Usuario   @relation("InvitacionCreador", fields: [idCreador], references: [id], onDelete: Cascade)

  @@index([idComunidad, fechaCreacion])
  @@map("invitacion")
}

model Canal {
  expulsiones CanalExpulsion[]
  silencios CanalSilencio[]
  id            Int       @id @default(autoincrement()) @map("id_canal")
  idComunidad   Int       @map("id_comunidad")
  nombre        String    @db.VarChar(32)
  tipo          TipoCanal @default(TEXTO)
  privado       Boolean   @default(false)
  posicion      Int       @default(0)
  fechaCreacion DateTime  @default(now()) @map("fecha_creacion")

  comunidad             Comunidad      @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  habilitacionesRol     CanalRol[]
  habilitacionesUsuario CanalUsuario[]
  habilitacionesRolPersonalizado CanalRolPersonalizado[]
  mensajes              Mensaje[]
  participantesLlamada  ParticipanteLlamada[]
  bloqueosMensaje BloqueoMensaje[]
  permisosGlobales PermisoCanal[] @default([VER, ESCRIBIR]) @map("permisos_globales")
  solicitudesAcceso SolicitudAccesoCanal[]

  @@unique([id, idComunidad])
  @@index([idComunidad, posicion])
  @@map("canal")
}

model CanalRol {
  idCanal  Int            @map("id_canal")
  rol      RolComunidad
  permisos PermisoCanal[]

  canal Canal @relation(fields: [idCanal], references: [id], onDelete: Cascade)

  @@id([idCanal, rol])
  @@map("canal_rol")
}

model CanalUsuario {
  idCanal     Int            @map("id_canal")
  idComunidad Int            @map("id_comunidad")
  idUsuario   Int            @map("id_usuario")
  permisos    PermisoCanal[]

  canal     Canal     @relation(fields: [idCanal, idComunidad], references: [id, idComunidad], onDelete: Cascade)
  membresia Membresia @relation(fields: [idComunidad, idUsuario], references: [idComunidad, idUsuario], onDelete: Cascade)

  @@id([idCanal, idUsuario])
  @@index([idComunidad, idUsuario])
  @@map("canal_usuario")
}

model RolPersonalizado {
  permisos String[] @default([])
  id            Int      @id @default(autoincrement()) @map("id_rol")
  idComunidad   Int      @map("id_comunidad")
  nombre        String   @db.VarChar(32)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  comunidad      Comunidad               @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  asignaciones   MembresiaRol[]
  habilitaciones CanalRolPersonalizado[]

  @@unique([id, idComunidad])
  @@index([idComunidad])
  @@map("rol_personalizado")
}

model MembresiaRol {
  idComunidad Int @map("id_comunidad")
  idUsuario   Int @map("id_usuario")
  idRol       Int @map("id_rol")

  membresia Membresia        @relation(fields: [idComunidad, idUsuario], references: [idComunidad, idUsuario], onDelete: Cascade)
  rol       RolPersonalizado @relation(fields: [idRol, idComunidad], references: [id, idComunidad], onDelete: Cascade)

  @@id([idRol, idUsuario])
  @@index([idComunidad, idUsuario])
  @@map("membresia_rol")
}

model CanalRolPersonalizado {
  idCanal     Int            @map("id_canal")
  idComunidad Int            @map("id_comunidad")
  idRol       Int            @map("id_rol")
  permisos    PermisoCanal[]

  canal Canal            @relation(fields: [idCanal, idComunidad], references: [id, idComunidad], onDelete: Cascade)
  rol   RolPersonalizado @relation(fields: [idRol, idComunidad], references: [id, idComunidad], onDelete: Cascade)

  @@id([idCanal, idRol])
  @@index([idRol])
  @@map("canal_rol_personalizado")
}

// Una fila por usuario: la clave primaria asegura una sola llamada activa por persona.
model ParticipanteLlamada {
  idUsuario         Int       @id @map("id_usuario")
  idCanal           Int       @map("id_canal")
  ingreso           String    @unique @db.VarChar(36)
  idSesion          Int?      @map("id_sesion")
  conectado         Boolean   @default(false)
  fechaAutorizacion DateTime  @default(now()) @map("fecha_autorizacion")
  fechaConexion     DateTime? @map("fecha_conexion")

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  canal   Canal   @relation(fields: [idCanal], references: [id], onDelete: Cascade)
  sesion  Sesion? @relation(fields: [idSesion], references: [id], onDelete: SetNull)

  @@index([idCanal, conectado])
  @@map("participante_llamada")
}


model BloqueoMensaje {
  id Int @id @default(autoincrement())
  idComunidad Int @map("id_comunidad")
  idCanal Int @map("id_canal")
  idAutor Int @map("id_autor")
  contenido String @db.VarChar(2000)
  motivo String @db.VarChar(100)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")
  comunidad Comunidad @relation(fields: [idComunidad], references: [id], onDelete: Cascade)
  canal Canal @relation(fields: [idCanal], references: [id], onDelete: Cascade)
  autor Usuario @relation(fields: [idAutor], references: [id], onDelete: Cascade)
  @@index([idComunidad, id], map: "bloqueo_mensaje_comunidad_fecha")
  @@map("bloqueo_mensaje")
}

model Notificacion {
  id Int @id @default(autoincrement())
  idUsuario Int @map("id_usuario")
  tipo String @db.VarChar(24)
  referencia Int
  distincion String? @db.VarChar(16)
  origen String @db.VarChar(80)
  leida Boolean @default(false)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")
  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  @@unique([idUsuario, origen], map: "notificacion_destino_origen")
  @@index([idUsuario, id], map: "notificacion_usuario_id")
  @@map("notificacion")
}

model Adjunto {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(120)
  tipo String @db.VarChar(80)
  datos Bytes
  idMensaje Int @unique @map("id_mensaje")
  mensaje Mensaje @relation(fields: [idMensaje], references: [id], onDelete: Cascade)
  @@map("adjunto")
}

model LlamadaPrivada {
  id String @id @db.Uuid
  idConversacion Int @map("id_conversacion")
  idEmisor Int @map("id_emisor")
  idReceptor Int @map("id_receptor")
  sesionEmisor Int? @map("sesion_emisor")
