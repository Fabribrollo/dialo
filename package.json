{
  "name": "dialo",
  "private": true,
  "version": "0.1.0",
  "description": "App de mensajería tipo Discord — proyecto final",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n back,front -c blue,magenta \"npm run dev -w apps/backend\" \"npm run dev -w apps/frontend\"",
    "dev:back": "npm run dev -w apps/backend",
    "dev:front": "npm run dev -w apps/frontend",
    "build": "npm run build -w apps/frontend",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "db:studio": "npm run db:studio -w apps/backend",
    "db:seed": "npm run db:seed -w apps/backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
