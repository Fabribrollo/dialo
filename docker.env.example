# Copiá este archivo como .env en la raíz del repo para docker compose.
# Todo es opcional: sin estos valores el chat funciona y las funciones externas quedan deshabilitadas.

# Puertos en tu máquina
APP_PORT=8080
DB_PORT=5433

# IA (propuestas de comunidades, canales, roles y moderación)
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=

# Imágenes (fotos de perfil, portadas, adjuntos)
CLOUDINARY_URL=

# Correo de recuperación de cuenta
RESEND_API_KEY=
MAIL_FROM=Dialo <onboarding@resend.dev>

# Llamadas con el LiveKit local (docker compose --profile llamadas up):
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_URL=http://livekit:7880
# LIVEKIT_API_KEY=dialo-local
# LIVEKIT_API_SECRET=dialo-local-secreto-de-desarrollo-123456
# Con LiveKit Cloud, completá solo URL, clave y secreto de tu proyecto.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
